# =====================================================================
#  Copy this file to .env.local  (or run `npm run setup`)
#  .env.local is git-ignored – never commit real secrets.
# =====================================================================

# --- Database (REQUIRED) ----------------------------------------------
# Any PostgreSQL works. With Supabase use: Project Settings → Database →
# Connection string → "URI" (Transaction pooler, port 6543, on Vercel).
# Example: postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Admin login (REQUIRED) -------------------------------------------
# The ONLY e-mail allowed to sign in to /admin.
ADMIN_EMAIL=you@example.com
# Recommended: a salted hash created by `npm run setup`  (format: scrypt$salt$hash)
ADMIN_PASSWORD_HASH=
# Alternative for quick testing only (plain text). Leave empty if you use the hash.
ADMIN_PASSWORD=
# Random string, 32+ characters. Signs the admin session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Public site (REQUIRED) -------------------------------------------
# Your final URL, no trailing slash. Used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form e-mail (optional) -----------------------------------
# Messages are ALWAYS saved in the admin inbox. To also get an e-mail:
# create a free key at https://resend.com
RESEND_API_KEY=
# Where notifications are delivered (your inbox)
CONTACT_RECEIVER_EMAIL=
# Sender shown in the e-mail. Use onboarding@resend.dev until you verify your domain.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- GitHub stats (optional) ------------------------------------------
# Username is edited in Admin → Site & SEO. A token (no scopes needed) raises
# the rate limit and enables pinned repos + the contribution graph.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Captcha (optional, Cloudflare Turnstile – free) ------------------
# https://dash.cloudflare.com → Turnstile. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
